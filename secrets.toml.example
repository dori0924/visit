# 이 파일을 같은 폴더에 secrets.toml로 복사한 뒤 값을 채우세요.
# secrets.toml은 Git에 올리지 않습니다(.gitignore에 포함).
# Streamlit Cloud에서는 앱 설정 > Secrets에 같은 내용을 붙여넣습니다.
#
# 안전교육 URL, 안내문, 서약서 본문, 로고는 여기가 아니라 앱의 관리자 모드 > 앱 설정에서 바꿉니다.

ADMIN_PASSWORD = "여기에-관리자-비밀번호"

# ── Google Sheets (운영용) ───────────────────────────────
# 아래 두 항목이 없으면 앱은 로컬 SQLite(data/visitor.db)를 사용합니다.
# 설정 방법은 README.md의 "Google Sheets 연결"을 보세요.
#
# SHEET_ID = "구글-시트-주소의-/d/와-/edit-사이-문자열"
#
# [gcp_service_account]
# 서비스 계정 JSON 키 파일의 내용을 키 = "값" 형태로 옮겨 적습니다.
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
